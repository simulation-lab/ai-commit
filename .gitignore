research/

# コメント: ログファイルをすべて無視
*.log

# 例外: このログファイルだけはGitで管理する
# !keep-this-file.log

# ビルド成果物や依存関係のディレクトリを無視
node_modules/
dist/
build/

# 環境変数などの機密情報ファイルを無視
.env
.env.local
*.pem

# OSやエディタ固有のファイルを無視
.DS_Store
Thumbs.db
.vscode/
.idea/

